# --- Requis (Vercel + local) -------------------------------------------------
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé publique : "anon" (legacy) ou "publishable" (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Optionnel ---------------------------------------------------------------
# URL d'intégration StreamYard (par défaut : le live Scutify).
NEXT_PUBLIC_STREAM_EMBED_URL=https://streamyard.com/watch/bjJkQR6HBCpX?embed=true

# --- Scripts locaux uniquement (JAMAIS sur Vercel, JAMAIS en NEXT_PUBLIC_) ----
# Utilisée seulement par `npm run create-admin`. Elle contourne RLS.
SUPABASE_SERVICE_ROLE_KEY=
