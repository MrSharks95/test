{%- comment -%}
  Contenu du tiroir panier en verre (hero-glass-cart) : barre de livraison offerte, lignes, total, commande.
  Rendu au chargement puis re-rendu via l'API de rendu de sections après chaque changement.
  Paramètres : s (réglages de la section), threshold (seuil de livraison offerte en centimes, 0 = désactivé).
{%- endcomment -%}

{%- if cart.item_count > 0 -%}
  {%- liquid
    assign gift = s.gift_threshold | default: 0 | times: 100
    assign goal = threshold
    if gift > goal
      assign goal = gift
    endif
  -%}
  {%- if goal > 0 -%}
    {%- liquid
      assign progress = cart.total_price | times: 100 | divided_by: goal | at_most: 100
      assign reached = false
      if threshold > 0 and cart.total_price < threshold
        assign remaining_money = threshold | minus: cart.total_price | money
        assign ship_text = s.ship_text | default: 'Plus que [montant] pour la livraison offerte'
        assign line = ship_text | escape | replace: '[montant]', remaining_money
      elsif gift > 0 and cart.total_price < gift
        assign remaining_money = gift | minus: cart.total_price | money
        assign gift_text = s.gift_text | default: 'Plus que [montant] pour un cadeau offert'
        assign line = gift_text | escape | replace: '[montant]', remaining_money
      elsif gift > 0
        assign reached = true
        assign line = s.gift_reached | default: 'Cadeau offert débloqué !' | escape
      else
        assign reached = true
        assign line = s.ship_reached | default: 'Livraison offerte débloquée !' | escape
      endif
    -%}
    <div class="gct__ship{% if reached %} is-reached{% endif %}">
      <p class="gct__ship-text">
        {%- if reached -%}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12l4 4L19 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {%- elsif threshold > 0 and cart.total_price < threshold -%}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="7" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="17" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
        {%- else -%}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 10h16v10H4zM3 7h18v3H3zM12 7v13M12 7c-2-3-5-3-5-1s3 1 5 1zm0 0c2-3 5-3 5-1s-3 1-5 1z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        {%- endif -%}
        {{ line }}
      </p>
      <div class="gct__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}">
        <i style="width: {{ progress }}%"></i>
        {%- if gift > threshold and threshold > 0 -%}
          {%- assign tick = threshold | times: 100 | divided_by: goal -%}
          <b class="gct__tick" style="left: {{ tick }}%" aria-hidden="true"></b>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <ul class="gct__items" role="list">
    {%- for item in cart.items -%}
      {%- liquid
        assign item_link = item.url
        if s.product_links_home
          assign item_link = routes.root_url | append: '#fiche=' | append: item.product.handle
        endif
      -%}
      <li class="gct__item" data-gct-item data-line="{{ forloop.index }}" data-key="{{ item.key }}" data-product-id="{{ item.product_id }}">
        <a class="gct__media" href="{{ item_link }}" tabindex="-1" aria-hidden="true">
          {%- if item.image -%}
            {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 240', sizes: '96px', alt: '' }}
          {%- else -%}
            <span class="gct__noimg"></span>
          {%- endif -%}
        </a>
        <div class="gct__info">
          {%- if s.show_vendor and item.product.vendor != blank -%}
            <p class="gct__kicker">{{ item.product.vendor | escape }}</p>
          {%- endif -%}
          <a class="gct__name" href="{{ item_link }}">{{ item.product.title | escape }}</a>
          {%- unless item.product.has_only_default_variant -%}
            <p class="gct__variant">{{ item.variant.title | escape }}</p>
          {%- endunless -%}
          {%- if item.selling_plan_allocation -%}
            <p class="gct__variant">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
          {%- endif -%}
          {%- for property in item.properties -%}
            {%- assign property_first_char = property.first | slice: 0 -%}
            {%- if property.last != blank and property_first_char != '_' -%}
              <p class="gct__variant">{{ property.first | escape }} : {{ property.last | escape }}</p>
            {%- endif -%}
          {%- endfor -%}
          {%- if item.line_level_discount_allocations.size > 0 -%}
            <ul class="gct__discounts" role="list">
              {%- for allocation in item.line_level_discount_allocations -%}
                <li>{{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="gct__row">
            <div class="gct__qty">
              <button type="button" data-gct-minus aria-label="Retirer un exemplaire">−</button>
              <input type="number" inputmode="numeric" min="0" max="999" value="{{ item.quantity }}" aria-label="Quantité" data-gct-input>
              <button type="button" data-gct-plus aria-label="Ajouter un exemplaire">+</button>
            </div>
            <p class="gct__price">
              {%- if item.original_line_price != item.final_line_price -%}
                <s>{{ item.original_line_price | money }}</s>
              {%- endif -%}
              <strong>{{ item.final_line_price | money }}</strong>
            </p>
          </div>
        </div>
        <button type="button" class="gct__remove" data-gct-remove aria-label="Retirer {{ item.product.title | escape }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </li>
    {%- endfor -%}
  </ul>

  <p class="gct__msg" role="alert" data-gct-msg hidden></p>

  {%- if s.show_upsell -%}
    {%- comment -%} Nouveauté « Complétez le kit » : rempli par le JS via les recommandations Shopify (désactivable) {%- endcomment -%}
    <div class="gct__upsell" data-gct-upsell data-limit="{{ s.upsell_limit | default: 3 }}" hidden>
      <h3 class="gct__h">{{ s.upsell_heading | default: 'Complétez le kit' | escape }}</h3>
      <ul class="gct__upsell-list" role="list" data-gct-upsell-list></ul>
    </div>
  {%- endif -%}

  <div class="gct__foot">
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <ul class="gct__discounts gct__discounts--cart" role="list">
        {%- for discount in cart.cart_level_discount_applications -%}
          <li>{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <div class="gct__total">
      <span>{{ s.subtotal_label | default: 'Sous-total' | escape }}</span>
      <strong data-gct-total>{{ cart.total_price | money_with_currency }}</strong>
    </div>
    <p class="gct__note">{{ s.note_text | default: 'Taxes et frais de livraison calculés à l’étape suivante.' | escape }}</p>
    <form action="{{ routes.cart_url }}" method="post" class="gct__checkout-form">
      <button type="submit" name="checkout" class="gct__checkout">
        {{ s.checkout_label | default: 'Commander' | escape }}
        <span class="gct__checkout-sep" aria-hidden="true"></span>
        {{ cart.total_price | money }}
      </button>
    </form>
    {%- if s.show_dynamic_checkout and additional_checkout_buttons -%}
      <div class="gct__dynamic">{{ content_for_additional_checkout_buttons }}</div>
    {%- endif -%}
    <button type="button" class="gct__continue" data-gct-close>{{ s.continue_label | default: 'Continuer mes achats' | escape }}</button>
    {%- if s.show_payment and shop.enabled_payment_types.size > 0 -%}
      <div class="gct__pay" aria-label="Moyens de paiement">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'gct__pay-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- else -%}
  <div class="gct__empty">
    <span class="gct__empty-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" focusable="false"><path d="M6 8h12l-1 12H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 8a3 3 0 0 1 6 0" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
    </span>
    <p class="gct__empty-title">{{ s.empty_title | default: 'Votre panier est vide' | escape }}</p>
    <p class="gct__empty-text">{{ s.empty_text | default: 'La gamme n’attend que vous.' | escape }}</p>
    <a class="gct__checkout" href="{{ s.empty_link | default: routes.all_products_collection_url }}">{{ s.empty_label | default: 'Découvrir la gamme' | escape }}</a>
  </div>
{%- endif -%}
