<div class="hsc-probe">{{ section.settings | json }}</div>
{% schema %}
{
  "name": "HSC probe D",
  "tag": "section",
  "class": "section-hero-scroll-car",
  "max_blocks": 4,
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Hero — allumage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Allumez le contact."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Balise du titre",
      "options": [
        {
          "value": "h1",
          "label": "H1 (page d'accueil)"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ],
      "default": "h1"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Un garage, une voiture, quatre gestes : carrosserie, portière, habitacle, jantes. Des produits pensés pour un résultat net, sans effort."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Découvrir les produits"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton",
      "info": "Laissez vide pour faire défiler jusqu'au premier arrêt."
    },
    {
      "type": "checkbox",
      "id": "show_sound",
      "label": "Afficher le bouton son",
      "default": true
    },
    {
      "type": "text",
      "id": "text_sound_on",
      "label": "Libellé « activer le son »",
      "default": "Activer le son"
    },
    {
      "type": "text",
      "id": "text_sound_off",
      "label": "Libellé « couper le son »",
      "default": "Couper le son"
    },
    {
      "type": "text",
      "id": "scroll_hint",
      "label": "Indicateur de défilement",
      "default": "Faire défiler"
    },
    {
      "type": "header",
      "content": "Séquence au scroll"
    },
    {
      "type": "select",
      "id": "sequence_mode",
      "label": "Mode de défilement",
      "options": [
        {
          "value": "scrub",
          "label": "Image par image (le scroll fait défiler les images)"
        },
        {
          "value": "chapters",
          "label": "Chapitres (chaque scroll lit la vidéo jusqu'au plan suivant)"
        }
      ],
      "default": "scrub",
      "info": "Chapitres : un cran de molette, un swipe, une flèche du clavier ou un bouton lance la vraie vidéo jusqu'à l'arrêt suivant ; en remontant, la vidéo inversée est lue. Réglages dans « Mode chapitres » plus bas."
    },
    {
      "type": "range",
      "id": "scroll_multiplier",
      "label": "Hauteur de la séquence (× 100vh)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 7
    },
    {
      "type": "number",
      "id": "frames_total",
      "label": "Nombre total de frames",
      "default": 248,
      "info": "Numéro de la dernière image (f_0248.webp → 248)."
    },
    {
      "type": "range",
      "id": "stop_range",
      "label": "Plage d'apparition des cartes (± frames)",
      "min": 2,
      "max": 60,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "snap_to_stops",
      "label": "Aimanter les arrêts",
      "default": true,
      "info": "À l'arrêt du scroll dans la plage d'un arrêt, la séquence se cale sur sa frame exacte."
    },
    {
      "type": "checkbox",
      "id": "mobile_sequence",
      "label": "Séquence au scroll sur mobile",
      "default": true,
      "info": "Décoché : sur mobile, la vidéo puis les produits empilés avec leur image statique (aucune frame chargée). Les visiteurs ayant activé « réduire les animations » ou l'économiseur de données voient toujours la version empilée."
    },
    {
      "type": "number",
      "id": "priority_count",
      "label": "Frames chargées en priorité",
      "default": 30,
      "info": "Chargées avant les autres, dès l'arrivée sur la page."
    },
    {
      "type": "text",
      "id": "sequence_label",
      "label": "Description accessible de la séquence",
      "default": "Dodge Challenger noire dans un garage : carrosserie, habitacle puis jante"
    },
    {
      "type": "header",
      "content": "Mode chapitres (lecture vidéo)"
    },
    {
      "type": "text",
      "id": "chapter_video_file",
      "label": "Plan-séquence (fichier dans /assets)",
      "default": "plan-sequence.mp4"
    },
    {
      "type": "text",
      "id": "chapter_video_reverse_file",
      "label": "Plan-séquence inversé (fichier dans /assets)",
      "default": "plan-sequence-reverse.mp4",
      "info": "La même vidéo lue à l'envers : en remontant, la marche arrière est aussi fluide que l'avant. Vide = retour par un court fondu."
    },
    {
      "type": "select",
      "id": "chapter_rate",
      "label": "Vitesse de lecture entre deux plans",
      "options": [
        {
          "value": "1",
          "label": "× 1 (vitesse réelle)"
        },
        {
          "value": "1.25",
          "label": "× 1,25"
        },
        {
          "value": "1.5",
          "label": "× 1,5"
        },
        {
          "value": "2",
          "label": "× 2"
        },
        {
          "value": "2.5",
          "label": "× 2,5"
        },
        {
          "value": "3",
          "label": "× 3"
        }
      ],
      "default": "1.5"
    },
    {
      "type": "text",
      "id": "chapter_end",
      "label": "Fin du plan final (secondes)",
      "default": "39.9",
      "info": "Dernier arrêt, sans produit. Ensuite, la page défile normalement."
    },
    {
      "type": "header",
      "content": "Fichiers (dans /assets)"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Vidéo d'allumage (Fichiers Shopify)",
      "info": "Recommandé : choisissez ou chargez la vidéo ici (hébergée et optimisée par Shopify). Si vide, le fichier ci-dessous dans /assets est utilisé."
    },
    {
      "type": "text",
      "id": "video_file",
      "label": "… ou vidéo d'allumage dans /assets",
      "default": "hero-ignition.mp4"
    },
    {
      "type": "text",
      "id": "audio_file",
      "label": "Son du moteur",
      "default": "hero-ignition.mp3"
    },
    {
      "type": "text",
      "id": "poster_file",
      "label": "Image poster",
      "default": "hero-poster.jpg"
    },
    {
      "type": "text",
      "id": "frame_first_file",
      "label": "Première image de la séquence",
      "default": "f_0001.webp",
      "info": "Les URL des autres images sont construites en remplaçant le numéro."
    },
    {
      "type": "header",
      "content": "Cartes produit"
    },
    {
      "type": "text",
      "id": "text_add",
      "label": "Bouton d'ajout",
      "default": "Ajouter au panier"
    },
    {
      "type": "text",
      "id": "text_added",
      "label": "Confirmation d'ajout",
      "default": "Ajouté au panier"
    },
    {
      "type": "text",
      "id": "text_unavailable",
      "label": "Produit indisponible",
      "default": "Indisponible"
    },
    {
      "type": "text",
      "id": "text_error",
      "label": "Message d'erreur",
      "default": "Impossible d'ajouter ce produit. Réessayez."
    },
    {
      "type": "text",
      "id": "text_close",
      "label": "Bouton de fermeture (point d'intérêt)",
      "default": "Fermer"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent",
      "default": "#FF7A1A",
      "info": "Boutons, points d'intérêt, petits titres des cartes, navigation des chapitres."
    },
    {
      "type": "header",
      "content": "Cartes produit — apparence"
    },
    {
      "type": "color",
      "id": "color_card_bg",
      "label": "Fond des cartes",
      "default": "#0C0C0E"
    },
    {
      "type": "range",
      "id": "card_bg_opacity",
      "label": "Opacité du fond des cartes",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 65,
      "info": "100 % = fond plein. Plus bas, la vidéo transparaît à travers la carte (effet verre dépoli). Avec un fond clair, passez les textes des cartes en foncé ci-dessous."
    },
    {
      "type": "range",
      "id": "product_title_size",
      "label": "Taille des titres produit",
      "min": 16,
      "max": 44,
      "step": 1,
      "unit": "px",
      "default": 25,
      "info": "Sur ordinateur. Sur mobile, la taille est réduite automatiquement (environ 2/3)."
    },
    {
      "type": "header",
      "content": "Couleurs des textes"
    },
    {
      "type": "color",
      "id": "color_title",
      "label": "Titre principal",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_subtitle",
      "label": "Sous-titre",
      "default": "#C8C8CC"
    },
    {
      "type": "color",
      "id": "color_product_title",
      "label": "Titres et prix des produits",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "color_card_text",
      "label": "Accroches et prix barrés",
      "default": "#C8C8CC"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "Texte des boutons",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "stop",
      "name": "Arrêt caméra",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produit"
        },
        {
          "type": "number",
          "id": "frame",
          "label": "Frame de l'arrêt",
          "default": 27,
          "info": "Numéro de l'image où la caméra s'immobilise."
        },
        {
          "type": "text",
          "id": "time",
          "label": "Mode chapitres : temps de l'arrêt (secondes)",
          "info": "Moment de la vidéo où elle s'arrête sur ce produit, ex. 10 ou 25.27."
        },
        {
          "type": "select",
          "id": "display",
          "label": "Affichage",
          "options": [
            {
              "value": "card",
              "label": "Carte latérale (apparaît seule)"
            },
            {
              "value": "hotspot",
              "label": "Point d'intérêt (clic pour ouvrir)"
            }
          ],
          "default": "card"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Point d'intérêt — position X (% de l'image)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Point d'intérêt — position Y (% de l'image)",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 50
        },
        {
          "type": "text",
          "id": "hotspot_label",
          "label": "Point d'intérêt — libellé",
          "default": "Voir le produit"
        },
        {
          "type": "range",
          "id": "focus_x",
          "label": "Cadrage mobile : point à garder visible (X %)",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 50,
          "info": "Sur un écran vertical, l'image 16:9 est recadrée. Abscisse (en % de l'image) à garder à l'écran à cet arrêt : la position du produit ou du point d'intérêt. 50 = centre."
        },
        {
          "type": "select",
          "id": "side",
          "label": "Côté de la carte",
          "options": [
            {
              "value": "left",
              "label": "Gauche"
            },
            {
              "value": "right",
              "label": "Droite"
            }
          ],
          "default": "right"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre court",
          "default": "Carrosserie"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Accroche (une ligne)",
          "default": "Un brillant profond, sans traces."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Image statique (mobile)"
        },
        {
          "type": "text",
          "id": "mobile_image_file",
          "label": "… ou fichier dans /assets",
          "default": "stop-carrosserie.jpg",
          "info": "Utilisé si aucune image n'est choisie ci-dessus."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HSC probe D",
      "blocks": [
        {
          "type": "stop",
          "settings": {
            "frame": 27,
            "time": "10",
            "side": "right",
            "title": "Carrosserie",
            "tagline": "Un brillant profond, sans traces.",
            "focus_x": 40,
            "mobile_image_file": "stop-carrosserie.jpg"
          }
        },
        {
          "type": "stop",
          "settings": {
            "frame": 82,
            "time": "19.8",
            "side": "right",
            "display": "hotspot",
            "hotspot_x": 15,
            "hotspot_y": 58,
            "hotspot_label": "Portière",
            "title": "Portière",
            "tagline": "Cuir et Alcantara ravivés, sans résidu.",
            "focus_x": 15,
            "mobile_image_file": "stop-porte.jpg"
          }
        },
        {
          "type": "stop",
          "settings": {
            "frame": 134,
            "time": "25.27",
            "side": "left",
            "display": "hotspot",
            "hotspot_x": 55,
            "hotspot_y": 66,
            "hotspot_label": "Habitacle",
            "title": "Intérieur",
            "tagline": "Plastiques et cuirs nourris, odeur de neuf.",
            "focus_x": 55,
            "mobile_image_file": "stop-interieur.jpg"
          }
        },
        {
          "type": "stop",
          "settings": {
            "frame": 213,
            "time": "34.8",
            "side": "left",
            "title": "Jante",
            "tagline": "Jantes nettes, étriers propres, sans frotter.",
            "focus_x": 65,
            "mobile_image_file": "stop-jante.jpg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
