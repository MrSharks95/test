{%- comment -%}
  Sans page produit — le gabarit product.json renvoie sur l'accueil, où la fiche « En savoir plus » du produit
  s'ouvre d'elle-même (/#fiche=handle). Dans l'éditeur de thème, pas de redirection : un simple encart.
  Retour arrière : recoller backup/templates-product.json (gabarit produit d'origine du thème).
{%- endcomment -%}

{{ 'hero-glass-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign target = routes.root_url | append: '#fiche=' | append: product.handle
-%}

{%- unless request.design_mode -%}
  <meta http-equiv="refresh" content="0; url={{ target }}">
  <script>window.location.replace({{ target | json }});</script>
{%- endunless -%}

<section
  class="hgs hgs-redirect"
  style="--hgs-accent: {{ s.accent | default: '#FF7A1A' }}; --hgs-bg: {{ s.color_bg | default: '#0B0B0D' }}; --hgs-ink: {{ s.color_text | default: '#FFFFFF' }}; --hgs-max: {{ settings.page_width | default: 1400 }}px;"
>
  <div class="hgs__glow" aria-hidden="true"></div>
  <div class="hgs__inner">
    <div class="hgs-404__panel">
      {%- if request.design_mode -%}
        <p class="hgs__kicker">Sans page produit</p>
        <h1 class="hgs__title">{{ product.title | escape }}</h1>
        <div class="hgs__text"><p>Sur la boutique, cette adresse renvoie à l'accueil et ouvre la fiche « En savoir plus » du produit. Pour retrouver une page produit classique, remettez la section « main-product » du thème dans ce gabarit.</p></div>
      {%- else -%}
        <h1 class="hgs__title">{{ product.title | escape }}</h1>
        {%- if s.text != blank -%}<div class="hgs__text">{{ s.text }}</div>{%- endif -%}
      {%- endif -%}
      <div class="hgs-404__actions">
        <a class="hgs__btn" href="{{ target }}">{{ s.button_label | default: 'Voir le produit' | escape }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sans page produit (verre)",
  "tag": "div",
  "class": "hero-no-product-page-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Renvoie toute adresse /products/… vers l'accueil, où la fiche « En savoir plus » du produit s'ouvre. Pas de redirection dans l'éditeur." },
    { "type": "richtext", "id": "text", "label": "Texte (si la redirection ne se fait pas)", "default": "<p>Ce produit se découvre sur la page d'accueil, dans le garage.</p>" },
    { "type": "text", "id": "button_label", "label": "Bouton", "default": "Voir le produit" },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "accent", "label": "Couleur d'accent", "default": "#FF7A1A" },
    { "type": "color", "id": "color_bg", "label": "Fond", "default": "#0B0B0D" },
    { "type": "color", "id": "color_text", "label": "Texte", "default": "#FFFFFF" }
  ],
  "presets": [
    { "name": "Sans page produit (verre)" }
  ]
}
{% endschema %}
